<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 11 (API 30) and older. -->
<full-backup-content>
    <!-- Listening history and detailed statistics. -->
    <include domain="database" path="catlytics.db" />

    <!-- User preferences and playlists. Playback state is intentionally transient. -->
    <include domain="file" path="datastore/app_preferences.preferences_pb" />
    <include domain="file" path="datastore/library_preferences.preferences_pb" />
    <include domain="file" path="datastore/playlists.preferences_pb" />
    <include domain="file" path="playlist_covers/" />
</full-backup-content>
